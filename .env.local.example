# Supabase project settings -> API
# https://supabase.com/dashboard/project/_/settings/api

# Project URL and anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER exposed to the browser or committed.
# Used by API routes that need to bypass RLS (e.g. admin approval actions).
SUPABASE_SERVICE_ROLE_KEY=
